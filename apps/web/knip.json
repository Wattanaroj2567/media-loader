  "project": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}"],
  "ignore": ["components/ui/**"],
  "ignoreDependencies": [
    "tw-animate-css",
    "drizzle-orm",
