{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "deadcode": "knip",
    "test": "node --experimental-strip-types --test \"lib/*.test.ts\"",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "db:generate": "drizzle-kit generate",
    "db:push": "node --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:pull": "node --env-file-if-exists=../../.env.local ./node_modules/drizzle-kit/bin.cjs pull"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "knip": "^6.44.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
