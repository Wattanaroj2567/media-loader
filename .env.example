# Media Loader Environment Example
# Copy this file to .env.local and fill in your actual values.
# Never commit real secrets to source control.

# =============================================================================
# 🔴 REQUIRED VARIABLES (Developer must populate these values from Supabase)
# =============================================================================

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# [REQUIRED] Same as NEXT_PUBLIC_SUPABASE_URL (for backend services)
SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API (JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> Database (Connection String URI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# [REQUIRED] Shared secret key between API & Worker for internal authorization
WORKER_SECRET=dev-worker-secret-key-123


# =============================================================================
# 🟢 PRE-CONFIGURED / OPTIONAL (Pre-populated defaults, no change required for local dev)
# =============================================================================

# Frontend & API Endpoints
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker Settings
WORKER_ID=local-worker-1
# Queue isolation: use local on your PC and railway on Railway. Railway is
# detected automatically when this is left empty.
WORKER_POOL=local
# Optional explicit runtime paths. Local development auto-detects Node and
# uses the worker-managed FFmpeg binary when system FFmpeg is unavailable.
NODE_PATH=
DENO_PATH=
FFMPEG_PATH=
MAX_FILE_SIZE_MB=500
TEMP_DIR=tmp/media-loader
MEDIA_OUTPUT_MODE=local_temp
MEDIA_STORAGE_BUCKET=media-downloads
TEMP_FILE_RETENTION_MINUTES=60
