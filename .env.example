# Media Loader Environment Example
# Copy this file to .env.local and fill in your actual values.
# Never commit real secrets to source control.

# =============================================================================
# 🔴 REQUIRED VARIABLES (Developer must populate these values from Supabase)
# =============================================================================

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# [REQUIRED] Same as NEXT_PUBLIC_SUPABASE_URL (for backend services)
SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API (JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> Database (Connection String URI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# [REQUIRED] Shared secret key between API & Worker for internal authorization
WORKER_SECRET=dev-worker-secret-key-123

# [REQUIRED] Fernet key that encrypts stored source URLs (API & Worker must share it).
# Job creation is disabled while this is empty. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_URL_ENCRYPTION_KEY=


# =============================================================================
# 🟢 PRE-CONFIGURED / OPTIONAL (Pre-populated defaults, no change required for local dev)
# =============================================================================

# Frontend & API Endpoints
# For local frontend development: http://localhost:8000
# For Cloudflare Workers: use an HTTPS API origin served through a named tunnel.
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
API_PORT=8000
# Allowed origins for CORS. Append your exact Workers frontend origin when deploying.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://media-loader.example.com

# Cloudflare Tunnel (Optional: for connecting the Docker backend to Cloudflare Workers over HTTPS)
# Leave empty to use Quick Tunnel (trycloudflare.com), or provide your Named Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_TOKEN=

# Worker Settings
WORKER_ID=local-worker-1
# Queue isolation: the API and the workers that share a queue must use the same
# pool name. Defaults to local when left empty.
WORKER_POOL=local
# Optional explicit runtime paths. Local development auto-detects Node and
# uses the worker-managed FFmpeg binary when system FFmpeg is unavailable.
# Example: NODE_PATH="C:/Program Files/nodejs/node.exe" or NODE_PATH=/usr/bin/node
NODE_PATH=
# Example: DENO_PATH=C:/tools/deno/deno.exe or DENO_PATH=/usr/local/bin/deno
DENO_PATH=
# Example: FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe or FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_PATH=
MAX_FILE_SIZE_MB=500
TEMP_DIR=tmp/media-loader
# Output storage mode: "local_temp" (default for local dev) or "r2" (Cloudflare R2 direct delivery)
MEDIA_OUTPUT_MODE=local_temp
MEDIA_STORAGE_BUCKET=media-downloads
TEMP_FILE_RETENTION_MINUTES=60
# Cloudflare R2 (Backend API & Worker only; required when MEDIA_OUTPUT_MODE=r2)
# Never expose R2 credentials to the frontend or NEXT_PUBLIC_ variables.
# Copy the Account ID from the Cloudflare dashboard.
# Example: R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCOUNT_ID=
# Leave empty to derive the endpoint from the Account ID, or copy the bucket's S3 API endpoint.
# Example: R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Copy both values from the same R2 API token's S3 credentials.
# Example: R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_ACCESS_KEY_ID=
# Example: R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_TTL_SECONDS=300
# SSRF-safe egress proxy (apps/proxy) for every user-derived media request.
# Docker Compose overrides this with http://ssrf-proxy:3128.
MEDIA_EGRESS_PROXY=http://127.0.0.1:3128
# Optional Web Push configuration. Keep VAPID_PRIVATE_KEY server-side only.
# Use the public and private values from the same generated VAPID key pair (Base64URL).
# Example: VAPID_PUBLIC_KEY=<base64url-vapid-public-key>
VAPID_PUBLIC_KEY=
# Example: VAPID_PRIVATE_KEY=<base64url-vapid-private-key>
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push-operations@example.com
