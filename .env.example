# Media Loader Environment Example
# Copy this file to .env.local and fill in your actual values.
# Never commit real secrets to source control.

# =============================================================================
# 🔴 REQUIRED VARIABLES (Developer must populate these values from Supabase)
# =============================================================================

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# [REQUIRED] Same as NEXT_PUBLIC_SUPABASE_URL (for backend services)
SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> API (JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# [REQUIRED] Get from Supabase Dashboard -> Project Settings -> Database (Connection String URI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# [REQUIRED] Shared secret key between API & Worker for internal authorization
WORKER_SECRET=dev-worker-secret-key-123

# [REQUIRED] Fernet key that encrypts stored source URLs (API & Worker must share it).
# Job creation is disabled while this is empty. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_URL_ENCRYPTION_KEY=


# =============================================================================
# 🟢 PRE-CONFIGURED / OPTIONAL (Pre-populated defaults, no change required for local dev)
# =============================================================================

# Frontend & API Endpoints
# For local frontend development: http://localhost:8000
# For Vercel frontend deployment: use Cloudflare Tunnel URL (e.g. https://media-api.yourdomain.com or https://xxxx.trycloudflare.com)
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
API_PORT=8000
# Allowed origins for CORS. Append your exact Vercel URL when deploying.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app

# Cloudflare Tunnel (Optional: for connecting local Docker backend to Vercel over HTTPS)
# Leave empty to use Quick Tunnel (trycloudflare.com), or provide your Named Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_TOKEN=

# Worker Settings
WORKER_ID=local-worker-1
# Queue isolation: the API and the workers that share a queue must use the same
# pool name. Defaults to local when left empty.
WORKER_POOL=local
# Optional explicit runtime paths. Local development auto-detects Node and
# uses the worker-managed FFmpeg binary when system FFmpeg is unavailable.
NODE_PATH=
DENO_PATH=
FFMPEG_PATH=
MAX_FILE_SIZE_MB=500
TEMP_DIR=tmp/media-loader
MEDIA_OUTPUT_MODE=local_temp
# SSRF-safe egress proxy (apps/proxy) for every user-derived media request.
# Docker Compose overrides this with http://ssrf-proxy:3128.
MEDIA_EGRESS_PROXY=http://127.0.0.1:3128
MEDIA_STORAGE_BUCKET=media-downloads
TEMP_FILE_RETENTION_MINUTES=60
