# Media Loader Environment Example
# Copy this file to .env.local and fill values locally.
# Never commit real secrets.

# Frontend public config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000

# Local Docker backend config
API_PORT=8000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker config
WORKER_SECRET=
WORKER_ID=local-worker-1
MAX_FILE_SIZE_MB=50
TEMP_DIR=/app/tmp/media-loader
MEDIA_OUTPUT_MODE=local_temp
MEDIA_STORAGE_BUCKET=media-downloads
TEMP_FILE_RETENTION_MINUTES=60

# Optional defaults
LOG_LEVEL=info
ENABLE_SUPABASE_REALTIME=false
DEFAULT_AUDIO_QUALITY=192kbps
DEFAULT_VIDEO_QUALITY=720p
AUTO_CLEANUP_DAYS=0
