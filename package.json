{
  "name": "media-loader-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c cyan,blue,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:log": "concurrently -k -n web,api,worker -c cyan,blue,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\" > tmp/dev.log 2>&1",
    "production": "pnpm build:web && pnpm start:web",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --port 8000",
    "dev:worker": "uv run --directory apps/worker python -m worker.main",
    "docker:build": "docker compose build api worker",
    "docker:up": "docker compose up -d --build api worker",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api worker",
    "docker:tunnel": "docker compose --profile tunnel up -d tunnel",
    "setup:api": "uv pip install --directory apps/api -e \".[dev]\"",
    "setup:worker": "uv pip install --directory apps/worker -e \".[dev]\"",
    "setup:py": "pnpm setup:api && pnpm setup:worker",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "lint": "pnpm lint:web && pnpm lint:api && pnpm lint:worker && pnpm lint:md",
    "lint:web": "pnpm --filter web lint",
    "lint:api": "uv run --no-sync --directory apps/api ruff check .",
    "lint:worker": "uv run --no-sync --directory apps/worker ruff check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "format": "pnpm format:web && pnpm format:api && pnpm format:worker",
    "format:web": "pnpm --filter web format",
    "format:api": "uv run --no-sync --directory apps/api ruff format .",
    "format:worker": "uv run --no-sync --directory apps/worker ruff format .",
    "deadcode": "pnpm deadcode:web && pnpm deadcode:api && pnpm deadcode:worker",
    "deadcode:web": "pnpm --filter web deadcode",
    "deadcode:api": "uv run --no-sync --directory apps/api vulture app/",
    "deadcode:worker": "uv run --no-sync --directory apps/worker vulture worker/",
    "test:web": "pnpm --filter web test",
    "test:api": "uv run --no-sync --directory apps/api pytest",
    "test:worker": "uv run --no-sync --directory apps/worker pytest",
    "test:api:e2e": "uv run --no-sync python scripts/test-e2e.py",
    "test:e2e": "pnpm --filter web test:e2e:mock",
    "check-env": "tsx scripts/check-env.ts",
    "tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/tunnel.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.4",
    "markdownlint-cli2": "^0.23.2",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
