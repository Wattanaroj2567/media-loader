{
  "name": "media-loader-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,blue,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --port 8000",
    "dev:worker": "uv run --directory apps/worker python -m worker.main",
    "setup:api": "uv pip install --directory apps/api -e .",
    "setup:worker": "uv pip install --directory apps/worker -e .",
    "setup:py": "pnpm setup:api && pnpm setup:worker",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "lint:web": "pnpm --filter web lint",
    "check-env": "tsx scripts/check-env.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
